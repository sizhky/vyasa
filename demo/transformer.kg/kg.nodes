model: Transformer
	dashed=true
	inherit=part
	part=io
	description=|
		Base model from Vaswani et al. (2017): d_model = 512, h = 8 heads, N = 6 layers per stack, d_ff = 2048, dropout 0.1.

		About 65M parameters. B is batch size, T is source length, T' is target length, V is vocabulary size (37k shared BPE for EN-DE).
	enc_in: INPUTS
		column=enc
		track=io
		shape=[B, T] int
		description=Source token ids, padded to length T. A padding mask of shape [B, 1, 1, T] travels with them.
	enc_emb: INPUT EMBEDDING
		column=enc
		track=embed
		part=block
		op=$E[x] \cdot \sqrt{d_{model}}$
		shape=[B, T] → [B, T, 512]
		params=V × 512, shared with the output embedding and the pre-softmax linear
		description=A table lookup. The $\sqrt{d_{model}}$ scale keeps embeddings comparable in size to the positional encoding.
	enc_add: +
		column=enc
		track=plus
		op=$\mathrm{Dropout}(x + PE)$
		shape=[B, T, 512]
		description=Element-wise sum, then dropout 0.1. Order information exists only from here on.
	enc_pe: ~
		column=enc_wave
		track=plus
		op=|
			$PE_{(pos,\,2i)} = \sin\left(pos / 10000^{2i/d_{model}}\right)$

			$PE_{(pos,\,2i+1)} = \cos\left(pos / 10000^{2i/d_{model}}\right)$
		shape=[T, 512], broadcast over B
		params=none
		description=Fixed sinusoids. Each dimension pair is a rotation, so PE(pos + k) is a linear function of PE(pos).
	enc_pe_note: POSITIONAL ENCODING
		column=enc_note
		track=plus
	enc_nx: Nx
		column=enc_wave
		track=fork2
		description=The encoder layer repeats N = 6 times. Each layer has its own weights.
	encoder: Encoder
		inherit=column,part
		column=enc
		part=block
		shape=[B, T, 512] → [B, T, 512]
		params=about 3.15M per layer, 18.9M for N = 6
		description=Each layer is self-attention, then a position-wise feed-forward network. Each sublayer is wrapped as LayerNorm(x + Sublayer(x)).
		enc_r1: residual
			track=res
			description=Copy of x for the skip connection around self-attention.
		enc_f1: qkv
			track=qkv
			description=Self-attention: one tensor x serves as query, key, and value.
		enc_an1: ADD & NORM
			track=norm1
			op=$\mathrm{LayerNorm}(x + \mathrm{Dropout}(\mathrm{MHA}(x)))$
			shape=[B, T, 512]
			params=γ, β: 2 × 512
			description=Post-LN, as in the paper. Normalises over the 512 features of each position.
		enc_mha: MULTI-HEAD ATTENTION
			internals=../mha.kg
			track=attn1
			op=|
				$\mathrm{head}_i = \mathrm{softmax}\left(\frac{Q W_i^Q (K W_i^K)^\top}{\sqrt{d_k}} + M\right) V W_i^V$

				$\mathrm{MHA} = \mathrm{Concat}(\mathrm{head}_1, \dots, \mathrm{head}_8)\, W^O$
			shape=Q, K, V [B, T, 512] → scores [B, 8, T, T] → [B, T, 512]
			params=4 × 512 × 512 + biases ≈ 1.05M
			description=h = 8 heads, d_k = d_v = 64. Cost is O(T² · d_model). The padding mask sets scores at pad keys to −∞.
		enc_r2: residual
			track=fork2
			description=Copy of x for the skip connection around the feed-forward network.
		enc_an2: ADD & NORM
			track=norm2
			op=$\mathrm{LayerNorm}(x + \mathrm{Dropout}(\mathrm{FFN}(x)))$
			shape=[B, T, 512]
			params=γ, β: 2 × 512
		enc_ff: FEED FORWARD
			track=attn2
			op=$\mathrm{FFN}(x) = \max(0,\, x W_1 + b_1)\, W_2 + b_2$
			shape=[B, T, 512] → [B, T, 2048] → [B, T, 512]
			params=2 × 512 × 2048 + biases ≈ 2.1M
			description=Applied to each position separately, with the same weights. Holds about two thirds of a layer's parameters.
	kv: memory
		column=mid
		track=fork2
		shape=[B, T, 512]
		description=Encoder output. Every decoder layer reads it as K and V. It is computed once per source sentence.
	dec_in: OUTPUTS (SHIFTED RIGHT)
		column=dec
		track=io
		shape=[B, T'] int
		description=Target ids shifted right by one, with BOS first. Position t sees only tokens before t (teacher forcing).
	dec_emb: OUTPUT EMBEDDING
		column=dec
		track=embed
		part=block
		op=$E[y] \cdot \sqrt{d_{model}}$
		shape=[B, T'] → [B, T', 512]
		params=shared with the input embedding
	dec_add: +
		column=dec
		track=plus
		op=$\mathrm{Dropout}(y + PE)$
		shape=[B, T', 512]
	dec_pe: ~
		column=dec_wave
		track=plus
		op=Same sinusoids as the encoder
		shape=[T', 512]
		params=none
	dec_pe_note: POSITIONAL ENCODING
		column=dec_note
		track=plus
	dec_nx: Nx
		column=dec_wave
		track=attn2
		description=The decoder layer repeats N = 6 times. Each layer has its own weights.
	decoder: Decoder
		inherit=column,part
		column=dec
		part=block
		shape=[B, T', 512] and memory [B, T, 512] → [B, T', 512]
		params=about 4.2M per layer, 25.2M for N = 6
		description=Each layer is masked self-attention, then cross-attention over the encoder memory, then a feed-forward network.
		dec_r1: residual
			track=res
			description=Copy of y for the skip connection around masked self-attention.
		dec_f1: qkv
			track=qkv
			description=Self-attention: one tensor y serves as query, key, and value.
		dec_an1: ADD & NORM
			track=norm1
			op=$\mathrm{LayerNorm}(y + \mathrm{Dropout}(\mathrm{MaskedMHA}(y)))$
			shape=[B, T', 512]
			params=γ, β: 2 × 512
		dec_mmha: MASKED MULTI-HEAD ATTENTION
			internals=../mha.kg
			track=attn1
			op=$\mathrm{softmax}\left(\frac{Q K^\top}{\sqrt{d_k}} + M\right) V, \quad M_{ij} = -\infty \text{ if } j > i$
			shape=[B, T', 512] → scores [B, 8, T', T'] → [B, T', 512]
			params=≈1.05M
			description=The causal mask keeps position i from reading later positions. Training then predicts all T' tokens in one pass.
		dec_r2: residual
			track=fork2
			description=Copy of y for the skip connection around cross-attention. The same tensor is the query.
		dec_an2: ADD & NORM
			track=norm2
			op=$\mathrm{LayerNorm}(y + \mathrm{Dropout}(\mathrm{CrossMHA}(y, m)))$
			shape=[B, T', 512]
			params=γ, β: 2 × 512
		dec_mha: MULTI-HEAD ATTENTION
			internals=../mha.kg
			track=attn2
			op=$\mathrm{softmax}\left(\frac{Q_y K_m^\top}{\sqrt{d_k}} + M_{pad}\right) V_m$
			shape=Q [B, T', 512], K and V [B, T, 512] → scores [B, 8, T', T] → [B, T', 512]
			params=≈1.05M
			description=Cross-attention. Each target position looks over the whole source sentence.
		dec_r3: residual
			track=fork3
			description=Copy of y for the skip connection around the feed-forward network.
		dec_an3: ADD & NORM
			track=norm3
			op=$\mathrm{LayerNorm}(y + \mathrm{Dropout}(\mathrm{FFN}(y)))$
			shape=[B, T', 512]
			params=γ, β: 2 × 512
		dec_ff: FEED FORWARD
			track=ff3
			op=$\mathrm{FFN}(y) = \max(0,\, y W_1 + b_1)\, W_2 + b_2$
			shape=[B, T', 512] → [B, T', 2048] → [B, T', 512]
			params=≈2.1M
	linear: LINEAR
		column=dec
		track=linear
		part=block
		op=$z = y E^\top$
		shape=[B, T', 512] → [B, T', V]
		params=tied to the embedding matrix E
		description=Projects each position onto the vocabulary. This is the widest tensor in the model.
	softmax: SOFTMAX
		column=dec
		track=softmax
		part=block
		op=$p_v = \dfrac{e^{z_v}}{\sum_u e^{z_u}}$
		shape=[B, T', V]
		description=Normalises over the vocabulary axis. Training uses cross-entropy with label smoothing ε = 0.1.
	prob: OUTPUT PROBABILITIES
		column=dec
		track=prob
		shape=[B, T', V]
		description=p(y_t | y_<t, x) for every position. At inference, decode one token at a time with beam size 4.
