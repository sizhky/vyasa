e01: enc_in -> enc_emb tokens shape="[B, T]"
e02: enc_emb -> enc_add embeds shape="[B, T, 512]"
e03: enc_pe -> enc_add positions edge_path=line shape="[T, 512]"
e04: enc_add -> enc_r1 feeds shape="[B, T, 512]"
e05: enc_r1 -> enc_f1 feeds shape="x → Q, K, V"
e06: enc_f1 -> enc_mha query target_port=bottom:20 shape=Q note="$x W^Q$: [B, T, 512] viewed as [B, 8, T, 64]"
e07: enc_f1 -> enc_mha key target_port=bottom:50 shape=K note="$x W^K$: [B, T, 512] viewed as [B, 8, T, 64]"
e08: enc_f1 -> enc_mha value target_port=bottom:80 shape=V note="$x W^V$: [B, T, 512] viewed as [B, 8, T, 64]"
e08b: enc_mha -> enc_an1 feeds shape="[B, T, 512]" note="Sublayer output, after dropout 0.1, is added to the residual x."
e09: enc_r1 -> enc_an1 residual shape="+ x" target_port=left note="x is added unchanged to the sublayer output, so gradients reach lower layers directly."
e10: enc_an1 -> enc_r2 feeds shape="[B, T, 512]"
e11: enc_r2 -> enc_ff feeds shape=x
e11b: enc_ff -> enc_an2 feeds shape="[B, T, 512]" note="FFN output, after dropout 0.1, is added to the residual x."
e12: enc_r2 -> enc_an2 residual shape="+ x" target_port=left note="x is added unchanged to the FFN output."
e13: enc_an2 -> kv memory source_port=top shape="[B, T, 512]" note="Output of layer 6 only. Every decoder layer reads this one tensor."
e14: kv -> dec_mha key target_port=bottom:15 shape=K note="$m W^K$: [B, T, 512] viewed as [B, 8, T, 64]"
e15: kv -> dec_mha value target_port=bottom:38 shape=V note="$m W^V$: [B, T, 512] viewed as [B, 8, T, 64]"
e21: dec_in -> dec_emb tokens shape="[B, T']"
e22: dec_emb -> dec_add embeds shape="[B, T', 512]"
e23: dec_pe -> dec_add positions edge_path=line shape="[T', 512]"
e24: dec_add -> dec_r1 feeds shape="[B, T', 512]"
e25: dec_r1 -> dec_f1 feeds shape="y → Q, K, V"
e26: dec_f1 -> dec_mmha query target_port=bottom:20 shape=Q note="$y W^Q$: [B, T', 512] viewed as [B, 8, T', 64]"
e27: dec_f1 -> dec_mmha key target_port=bottom:50 shape=K note="$y W^K$: [B, T', 512] viewed as [B, 8, T', 64]"
e28: dec_f1 -> dec_mmha value target_port=bottom:80 shape=V note="$y W^V$: [B, T', 512] viewed as [B, 8, T', 64]"
e28b: dec_mmha -> dec_an1 feeds shape="[B, T', 512]" note="Masked attention output, after dropout 0.1, is added to the residual y."
e29: dec_r1 -> dec_an1 residual shape="+ y" target_port=right note="y is added unchanged to the masked attention output."
e30: dec_an1 -> dec_r2 feeds shape="[B, T', 512]"
e31: dec_r2 -> dec_mha query target_port=bottom:80 shape=Q note="$y W^Q$: [B, T', 512] viewed as [B, 8, T', 64]"
e31b: dec_mha -> dec_an2 feeds shape="[B, T', 512]" note="Cross-attention output, after dropout 0.1, is added to the residual y."
e32: dec_r2 -> dec_an2 residual shape="+ y" target_port=right note="y is added unchanged to the cross-attention output."
e33: dec_an2 -> dec_r3 feeds shape="[B, T', 512]"
e34: dec_r3 -> dec_ff feeds shape=y
e34b: dec_ff -> dec_an3 feeds shape="[B, T', 512]" note="FFN output, after dropout 0.1, is added to the residual y."
e35: dec_r3 -> dec_an3 residual shape="+ y" target_port=right note="y is added unchanged to the FFN output."
e36: dec_an3 -> linear feeds shape="[B, T', 512]"
e37: linear -> softmax logits shape="[B, T', V]"
e38: softmax -> prob probabilities shape="[B, T', V]"
