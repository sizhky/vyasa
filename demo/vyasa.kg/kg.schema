@graph id=vyasa-kernel title="From files on disk to the Vyasa UI"
hover_attrs=description,code
pair_by=pair
edge_color_by=step
edge_label_from=note
default_view=flow

@sources
nodes=kg.nodes
attrs=kg.attrs
page:
	edges=kg.edges
fence:
	edges=kg.fence.edges
extensions:
	edges=kg.extensions.edges
palette=kg.palette
code_source=../../

@relations
resolves color=relation.resolves
reads color=relation.reads
renders color=relation.renders
registers color=relation.registers
shows color=relation.shows
returns color=relation.returns
replies color=relation.replies

@views
flow:
	source=page
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	sequence_activation=true
	sequence_lanes=browser-ui,content-route,content-tree,path-resolver,not-found,frontmatter-reader,filesystem-backend,worktree-reader,markdown-renderer,document-page
	sequence_message=message
	sequence_fragment=fragment
	sequence_operand=operand
	sequence_operand_note=operand_note
	color_by=layer
	edge_color_by=step
	edge_label_from=note
	hover_attrs=description,code
	caption="Rows run from top to bottom, in the order the steps happen. Every lane is a participant that can receive a call. A document and a response are values carried on arrows, so neither has a lane. A row with two lines is one exchange. The upper line is the call and the lower line is its reply. A vertical bar on a lane marks an execution that has not returned yet. A box drawn around a group of rows is a combined fragment, and the tag in the top-left corner of a box names its operator. render_post_detail is the single function that runs every step in this view. render_post_detail asks the content tree first. content_path_for_slug and the 404 response run only when the content tree returns nothing."
	slides:
		route: Steps 1 to 4 — find the document
			nodes=browser-ui,content-route,content-tree,path-resolver,not-found
			caption="The browser requests a page, and render_post_detail handles it. render_post_detail asks the content tree for the document first. The opt box holds the fallback that runs when the content tree does not index that slug. The break box holds the 404 response, which replaces every step below it."
		read: Steps 5 to 7 — read the file
			nodes=content-route,frontmatter-reader,filesystem-backend,worktree-reader
			caption="render_post_detail reads the file through parse_frontmatter. The alt box holds the one branch inside parse_frontmatter. A git-ref page arrives as a VirtualPath and is read through the content backend. Every other page is a plain Path and is read from disk."
		render: Steps 8 to 9 — build the page
			nodes=content-route,markdown-renderer,document-page
			caption="render_post_detail renders the Markdown body with from_md. render_post_detail then builds a DocumentPage and calls its render method."
		ui: Step 10 — return the response
			nodes=content-route,document-page,browser-ui
			caption="DocumentPage returns the finished HTML response. The open arrowhead marks this message as asynchronous. render_post_detail returns the response and does not wait for the browser."
fence:
	source=fence
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	sequence_activation=true
	sequence_lanes=tasks-extension,extension-runtime,markdown-renderer,fence-dispatch,code-shell,items-handler,pack-loader,context-pack,pack-files,kg-cache,graph-builder,items-widget
	sequence_message=message
	sequence_fragment=fragment
	sequence_operand=operand
	sequence_operand_note=operand_note
	color_by=layer
	edge_color_by=role
	edge_label_from=note
	hover_attrs=description,code
	caption="This view uses UML interaction notation. A filled arrowhead marks a synchronous call, and the sender waits for it. The reply to a synchronous call is drawn as a second line on the same row. An open arrowhead marks an asynchronous message, and step 11 is the only one in this view. A vertical bar on a lane marks an execution that has not returned yet. A box drawn around a group of rows is a combined fragment. The tag in the top-left corner of a box names its operator. This view uses five operators. break replaces the remainder of the enclosing interaction. alt runs exactly one operand, chosen by its guard. opt runs its single operand only when the guard holds. loop repeats the rows it encloses. ref refers to an interaction that is defined outside this view. Guards and operand descriptions are not drawn on the box. Hover or click a corner tag to read them."
	slides:
		register: Step 1 — register the fence handler
			nodes=tasks-extension,extension-runtime
			caption="The items extension writes one entry into markdown_fences at startup. This is the only step in this view that runs outside a request."
		dispatch: Steps 2 to 4 — resolve the handler
			nodes=markdown-renderer,fence-dispatch,extension-runtime,code-shell
			caption="from_md reaches a fenced block and calls render_block_code. render_block_code reads the language from the info string and asks the extension runtime which handler is registered for that language. The break box holds the miss. render_block_code returns a plain code block, and no step below the break box runs."
		load: Steps 5 to 9 — read the pack
			nodes=fence-dispatch,items-handler,pack-loader,context-pack,pack-files,kg-cache
			caption="The handler receives the fence body, the render context and the fence attributes. read_kg_pack then branches on the shape of the pack. A pack that declares contexts is delegated to _read_context_kg_pack. A plain pack is built here, by looping over the sources its views name and optionally writing a cache."
		build: Step 10 — build the drawable graph
			nodes=items-handler,graph-builder
			caption="The model is not the drawable graph, because a group can be collapsed. build_collapsed_graph flattens the model into one node list and one edge list."
		emit: Step 11 — return the widget
			nodes=fence-dispatch,items-widget
			caption="This is the only asynchronous row in this view. render_block_code returns a div that carries the model as an escaped JSON attribute. The open arrowhead marks that no reply is expected. tasks.js reads that attribute in the browser and draws the graph."
extensions:
	source=extensions
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	sequence_activation=true
	sequence_lanes=extension-boot,extension-catalog,extension-plan,extension-any,extension-app,registration-guard,extension-runtime
	color_by=layer
	edge_color_by=role
	edge_label_from=note
	hover_attrs=description,code
	caption="This view shows how an extension registers with Vyasa, using the items fence as the example claim. build_extension_runtime is the single function that runs every step. Two activation bars are nested. The extension bar stays open while the extension makes its claim, and the registrar bar stays open while the guard checks that claim. The capability guard is the reason an undeclared claim cannot reach the runtime. The extension runtime is the last lane because it is written last, and no request reads a slot before boot finishes."
	slides:
		catalog: Steps 1 to 2 — list and enable extensions
			nodes=extension-boot,extension-catalog,extension-plan
			caption="The catalog and the plan answer two different questions. The catalog lists every extension that is installed, built-in ones first and then any module the config names. The plan states which of those extensions are enabled, from a preset plus per-category overrides."
		register: Step 3 — call register once per extension
			nodes=extension-boot,extension-any,extension-app
			caption="Boot calls register once per enabled extension, in catalog order. Each call carries a registrars object bound to that extension. An extension can claim a slot only during this call."
		claim: Steps 4 to 5 — check each claim
			nodes=extension-any,extension-app,registration-guard
			caption="Every claim passes through a registrar. The registrar asks the capability guard whether the extension declared that capability. An undeclared claim raises an error and boot fails. Extension metadata is therefore a complete list of what an extension can reach."
		write: Step 6 — write the runtime slot
			nodes=extension-app,extension-runtime
			caption="The runtime is written only at this step. The runtime is complete once the last extension returns, and it does not change after that. Every request reads the slots this pass filled."
