@graph id=vyasa-kernel title="From files on disk to the Vyasa UI"
hover_attrs=description,code
pair_by=pair
edge_color_by=step
edge_label_from=note
default_view=flow

@sources
nodes=kg.nodes
attrs=kg.attrs
base:
	edges=kg.edges
fence:
	edges=kg.fence.edges
palette=kg.palette
code_source=../../

@relations
resolves color=relation.resolves
reads color=relation.reads
renders color=relation.renders
registers color=relation.registers
shows color=relation.shows
returns color=relation.returns
replies color=relation.replies

@views
flow:
	source=base
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	color_by=layer
	edge_color_by=step
	edge_label_from=note
	hover_attrs=description,code
	caption="Read the rows from top to bottom. One lifeline owns the page, render_post_detail. A row with two lines is one exchange: the solid line is the call, the dashed line under it is the value coming back. Every lane is something that can receive a call, so a document and a response are values on the arrows, not lanes."
	slides:
		route: Steps 1 to 2 — the route takes over
			nodes=browser-ui,content-route,path-resolver
			caption="The browser asks for a page. post_detail hands it to render_post_detail, which turns the slug into a file path."
		read: Steps 3 to 4 — read the file
			nodes=content-route,frontmatter-reader,filesystem-backend
			caption="The route reads the file through parse_frontmatter. A git-ref page takes the backend branch instead of a plain Path."
		render: Steps 5 to 6 — build the page
			nodes=content-route,markdown-renderer,document-page
			caption="The route renders the Markdown body, then builds DocumentPage and calls render on it."
		ui: Step 7 — show the result
			nodes=content-route,document-page,browser-ui
			caption="DocumentPage returns the finished HTML response. The route returns it and the browser displays the page."
fence:
	source=fence
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	sequence_activation=true
	color_by=layer
	edge_color_by=role
	edge_label_from=note
	hover_attrs=description,code
	caption="The same reading rule as above: solid line is the call, dashed line under it is the value coming back. One lifeline owns the block, render_block_code. It never learns what items means; it only asks the registry who owns the word. The bar on the items handler is its frame: it opens when the call lands and closes when the reply leaves, so the pack read and the graph build are visibly inside step 4, not after it."
	slides:
		register: Step 1 — the fence gets an owner
			nodes=tasks-extension,extension-runtime
			caption="Before any request, the items extension writes one entry into markdown_fences. This is the only step here that is not part of a request, which is why it stands alone."
		dispatch: Steps 2 to 3 — find the handler
			nodes=markdown-renderer,fence-dispatch,extension-runtime
			caption="from_md reaches a fenced block. The dispatch reads the language off the info string and asks the registry for its owner. A miss falls through to a plain code block."
		load: Steps 4 to 5 — read the pack
			nodes=fence-dispatch,items-handler,pack-loader
			caption="The handler gets the fence body and nothing else. Here the body is frontmatter naming a pack, so the graph is read from disk rather than from the page."
		build: Step 6 — build the drawable graph
			nodes=items-handler,graph-builder
			caption="The model is not what gets drawn. Groups can collapse, so this step flattens the model into a node list and an edge list."
		emit: Step 7 — hand it to the browser
			nodes=fence-dispatch,items-widget
			caption="A div carrying the model as JSON. The Python side is done, and tasks.js draws the picture you are reading."
