@graph id=vyasa-kernel title="From files on disk to the Vyasa UI"
hover_attrs=description,code

@sources
nodes=kg.nodes
attrs=kg.attrs
base:
	edges=kg.edges
palette=kg.palette
code_source=../../

@relations
resolves color=relation.resolves
reads color=relation.reads
renders color=relation.renders
shows color=relation.shows

@views
flow:
	source=base
	layout=layered
	layered_tier=tier
	layered_order=request,route,steps,browser
	layered_aside=ref-read
	color_by=layer
	edge_color_by=role
	edge_label_from=note
	hover_attrs=description,code
	caption="One function owns the page: render_post_detail. Every arrow out of it is a real call, and its code link shows the exact line. The helpers do not call each other."
	slides:
		route: Steps 1 to 2 — the route takes over
			nodes=page-file,content-route,path-resolver
			caption="post_detail hands the request to render_post_detail. The route turns the slug into a file path."
		read: Step 3 — read the file
			nodes=content-route,frontmatter-reader,filesystem-backend
			caption="The route reads the file through parse_frontmatter. A git-ref page takes the backend branch instead of a plain Path."
		render: Steps 4 to 5 — build the page
			nodes=content-route,markdown-renderer,html-response
			caption="The route renders the Markdown body, then puts the content into DocumentPage."
		ui: Step 6 — show the result
			nodes=html-response,browser-ui
			caption="The HTML response leaves Vyasa and the browser displays the page."
