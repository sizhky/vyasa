@graph id=vyasa-kernel title="From files on disk to the Vyasa UI"
hover_attrs=description,code
pair_by=pair
edge_color_by=step
edge_label_from=note
default_view=flow

@sources
nodes=kg.nodes
attrs=kg.attrs
page:
	edges=kg.edges
fence:
	edges=kg.fence.edges
extensions:
	edges=kg.extensions.edges
palette=kg.palette
code_source=../../

@relations
resolves color=relation.resolves
reads color=relation.reads
renders color=relation.renders
registers color=relation.registers
shows color=relation.shows
returns color=relation.returns
replies color=relation.replies

@views
flow:
	source=page
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	sequence_activation=true
	sequence_lanes=browser-ui,content-route,content-tree,path-resolver,not-found,frontmatter-reader,filesystem-backend,worktree-reader,markdown-renderer,document-page
	sequence_message=message
	sequence_fragment=fragment
	sequence_operand=operand
	sequence_operand_note=operand_note
	color_by=layer
	edge_color_by=step
	edge_label_from=note
	hover_attrs=description,code
	caption="render_post_detail is the single function that runs every step in this view. render_post_detail asks the content tree first. content_path_for_slug and the 404 response run only when the content tree returns nothing."
	slides:
		route: Steps 1 to 4 — find the document
			nodes=browser-ui,content-route,content-tree,path-resolver,not-found
			caption="The browser requests a page, and render_post_detail handles it. render_post_detail asks the content tree for the document first. A missing tree entry falls back to content_path_for_slug. A missing page returns 404."
		read: Steps 5 to 7 — read the file
			nodes=content-route,frontmatter-reader,filesystem-backend,worktree-reader
			caption="render_post_detail reads the file through parse_frontmatter. A git-ref page arrives as a VirtualPath and is read through the content backend. Every other page is a plain Path and is read from disk."
		render: Steps 8 to 9 — build the page
			nodes=content-route,markdown-renderer,document-page
			caption="render_post_detail renders the Markdown body with from_md. render_post_detail then builds a DocumentPage and calls its render method."
		ui: Step 10 — return the response
			nodes=content-route,document-page,browser-ui
			caption="DocumentPage returns the finished HTML response. render_post_detail returns the response to the browser."
fence:
	source=fence
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	sequence_activation=true
	sequence_lanes=tasks-extension,extension-runtime,markdown-renderer,fence-dispatch,code-shell,items-handler,fence-parser,pack-loader,context-pack,pack-files,kg-cache,graph-builder,items-widget
	sequence_message=message
	sequence_fragment=fragment
	sequence_operand=operand
	sequence_operand_note=operand_note
	color_by=layer
	edge_color_by=role
	edge_label_from=note
	hover_attrs=description,code
	caption="from_md reaches a fenced block and calls render_block_code. The handler resolves the registered language, loads the selected pack, builds the drawable graph, and returns the widget model."
	slides:
		register: Step 1 — register the fence handler
			nodes=tasks-extension,extension-runtime
			caption="The items extension writes one entry into markdown_fences at startup. This is the only step in this view that runs outside a request."
		dispatch: Steps 2 to 4 — resolve the handler
			nodes=markdown-renderer,fence-dispatch,extension-runtime,code-shell
			caption="from_md reaches a fenced block and calls render_block_code. render_block_code reads the language from the info string and asks the extension runtime which handler is registered for that language. An unregistered language returns a plain code block."
		load: Steps 5 to 10 — read the pack
			nodes=fence-dispatch,items-handler,fence-parser,pack-loader,context-pack,pack-files,kg-cache
			caption="The handler receives the fence body, the render context and the fence attributes. It parses that body with parse_tasks_text, and the items_schema key inside it is what reaches the pack loader. read_kg_pack then branches on the shape of the pack. A pack that declares contexts is delegated to _read_context_kg_pack. A plain pack is built here, by looping over the sources its views name and optionally writing a cache."
		build: Step 11 — build the drawable graph
			nodes=items-handler,graph-builder
			caption="The model is not the drawable graph, because a group can be collapsed. build_collapsed_graph flattens the model into one node list and one edge list."
		emit: Step 12 — return the widget
			nodes=fence-dispatch,items-widget
			caption="render_block_code returns a div that carries the model as an escaped JSON attribute. tasks.js reads that attribute in the browser and draws the graph."
extensions:
	source=extensions
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	sequence_activation=true
	sequence_lanes=extension-boot,extension-catalog,extension-plan,extension-any,extension-app,registration-guard,extension-runtime
	color_by=layer
	edge_color_by=role
	edge_label_from=note
	hover_attrs=description,code
	caption="This view shows how an extension registers with Vyasa, using the items fence as the example claim. build_extension_runtime drives every step and delegates the register loop to _configure_extensions. The capability guard prevents an undeclared claim from reaching the runtime. The runtime is complete before any request reads its slots."
	slides:
		catalog: Steps 1 to 2 — list and enable extensions
			nodes=extension-boot,extension-catalog,extension-plan
			caption="The catalog and the plan answer two different questions. The catalog lists every extension that is installed, built-in ones first and then any module the config names. The plan states which of those extensions are enabled, from a preset plus per-category overrides."
		register: Step 3 — call register once per extension
			nodes=extension-boot,extension-any,extension-app
			caption="Boot calls register once per enabled extension, in catalog order. Each call carries a registrars object bound to that extension. An extension can claim a slot only during this call."
		claim: Steps 4 to 5 — check each claim
			nodes=extension-any,extension-app,registration-guard
			caption="Every claim passes through a registrar. The registrar asks the capability guard whether the extension declared that capability. An undeclared claim raises an error and boot fails. Extension metadata is therefore a complete list of what an extension can reach."
		write: Step 6 — write the runtime slot
			nodes=extension-app,extension-runtime
			caption="The runtime is written only at this step. The runtime is complete once the last extension returns, and it does not change after that. Every request reads the slots this pass filled."
