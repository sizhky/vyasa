  resolve: e2 e3
  read: e4 e5 e6 e7
  render: e8 e9 e10 e11
  show: e12
  register: f1
  dispatch: f2 f3 f4
  handle: f5 f10
  load: f6 f7
  build: f8 f9
  emit: f11
step:
  s1: e1
  s2: e2
  s3: e3
  s4: e4
  s5: e5
  s6: e6
  s7: e7
  s8: e8
  s9: e9
  s10: e10
  s11: e11
  s12: e12
