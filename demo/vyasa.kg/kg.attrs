@node_attrs
layer:
  content: page-file
  core: content-route path-resolver frontmatter-reader filesystem-backend
  pipeline: markdown-renderer
  surface: html-response browser-ui

@edge_attrs
role:
  call: e1 e2 e4 e7 e9
  reply: e3 e5 e8 e10
  branch: e6
  boundary: e11
phase:
  request: e1
  resolve: e2 e3
  read: e4 e5 e6
  render: e7 e8 e9 e10
  show: e11
