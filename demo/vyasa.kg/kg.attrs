@node_attrs
tier:
  request: page-file
  route: content-route
  steps: path-resolver frontmatter-reader markdown-renderer html-response
  browser: browser-ui
  ref-read: filesystem-backend
layer:
  content: page-file
  core: content-route path-resolver frontmatter-reader filesystem-backend
  pipeline: markdown-renderer
  surface: html-response browser-ui

@edge_attrs
role:
  call: e1 e2 e3 e4 e5
  branch: e6
  boundary: e7
