@node_attrs
layer:
  core: content-route path-resolver frontmatter-reader filesystem-backend extension-runtime
  pipeline: markdown-renderer fence-dispatch
  extension: tasks-extension items-handler pack-loader graph-builder
  surface: document-page browser-ui items-widget

@edge_attrs
role:
  call: e1 e2 e4 e8 e10 f2 f3 f5 f6 f8
