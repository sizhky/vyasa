@node_attrs
layer:
  content: page-file
  core: content-route path-resolver frontmatter-reader filesystem-backend
  pipeline: markdown-renderer
  surface: html-response browser-ui

@edge_attrs
role:
  call: e1 e2 e3 e5 e6
  branch: e4
  boundary: e7
phase:
  request: e1
  resolve: e2
  read: e3 e4
  render: e5 e6
  show: e7
