@graph id=python-dotenv title="How load_dotenv loads values"
hover_attrs=description,code
pair_by=pair
default_view=load

@sources
nodes=kg.nodes
attrs=kg.attrs
load:
	edges=kg.edges
parse_stream:
	nodes=kg.stream.nodes
	edges=kg.stream.edges
code_source=git+https://github.com/theskumar/python-dotenv@v1.0.1

@relations
calls color=relation.calls
returns color=relation.returns
checks color=relation.checks
writes color=relation.writes

@views
load:
	source=load
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	sequence_activation=true
	sequence_lanes=caller,loader,path-finder,parser,environment
	sequence_message=message
	sequence_fragment=fragment
	sequence_operand=operand
	sequence_operand_note=operand_note
	edge_color_by=step
	edge_label_from=note
	hover_attrs=description,code
	caption="One call moves through path selection, parsing, and environment writes. The opt branch uses [find_dotenv](src/dotenv/main.py){show=symbol symbol=find_dotenv kind=function} when the caller gives no path. The alt branch preserves an existing environment value unless override=True."
	slides:
		start: Steps 1 to 2 — choose the file
			nodes=caller,loader,path-finder
			caption="[load_dotenv](src/dotenv/main.py){show=symbol symbol=load_dotenv kind=function} builds a [DotEnv](src/dotenv/main.py){show=symbol symbol=DotEnv kind=class} object. With no path or stream, it asks [find_dotenv](src/dotenv/main.py){show=symbol symbol=find_dotenv kind=function} for the nearest .env file."
			read: Steps 3 to 5 — parse values
			nodes=loader,parser,environment
			caption="[DotEnv.dict](src/dotenv/main.py){show=symbol symbol=dict kind=method} reads the stream and turns each assignment into a key and value. The parser does not write process state."
			write: Steps 6 to 8 — apply the rule
			nodes=loader,environment,caller
			caption="[set_as_environment_variables](src/dotenv/main.py){show=symbol symbol=set_as_environment_variables kind=method} checks each parsed key. An existing key is skipped when override is false; otherwise the value is written."
parse_stream:
	source=parse_stream
	layout=sequence
	sequence_role=role
	sequence_activation=true
	sequence_lanes=stream-parser,stream-reader,binding-parser,binding-reader,key-parser,value-parser,unquoted-value-parser,escape-decoder,binding-record,error-recovery
	sequence_message=message
	sequence_fragment=fragment
	sequence_operand=operand
	edge_label_from=note
	hover_attrs=description,code
	caption="Iteration starts this [parse_stream](src/dotenv/parser.py){show=symbol symbol=parse_stream kind=function} generator. [Reader](src/dotenv/parser.py){show=symbol symbol=Reader kind=class} reads the whole input once and tracks a character position. Each advance checks for remaining text. If text remains, [parse_binding](src/dotenv/parser.py){show=symbol symbol=parse_binding kind=function} marks the start, consumes whitespace and an optional export prefix, parses a key, selects a value parser, consumes comments and the line ending, then returns a [Binding](src/dotenv/parser.py){show=symbol symbol=Binding kind=class}. [parse_stream](src/dotenv/parser.py){show=symbol symbol=parse_stream kind=function} yields that record and pauses until the consumer resumes. A false check ends iteration. Empty input yields nothing. A parser error consumes the rest of the line and returns an error [Binding](src/dotenv/parser.py){show=symbol symbol=Binding kind=class}, so one malformed line does not stop the stream."
	slides:
		iterate: Steps 1 to 6 — walk the stream
			nodes=stream-parser,stream-reader,binding-parser
			caption="[parse_stream](src/dotenv/parser.py){show=symbol symbol=parse_stream kind=function} owns iteration. It constructs one [Reader](src/dotenv/parser.py){show=symbol symbol=Reader kind=class}, checks has_next before each binding, delegates one record to [parse_binding](src/dotenv/parser.py){show=symbol symbol=parse_binding kind=function}, yields that record, and resumes at the loop check."
		binding: Steps 7 to 25 — parse one binding
			nodes=binding-parser,binding-reader,key-parser,value-parser,unquoted-value-parser,escape-decoder,binding-record,error-recovery
			caption="[parse_binding](src/dotenv/parser.py){show=symbol symbol=parse_binding kind=function} owns one record. It marks the start so the returned [Binding](src/dotenv/parser.py){show=symbol symbol=Binding kind=class} can preserve original text and line number. It then consumes the grammar in order. [parse_key](src/dotenv/parser.py){show=symbol symbol=parse_key kind=function} handles quoted and unquoted keys. [parse_value](src/dotenv/parser.py){show=symbol symbol=parse_value kind=function} chooses quoted, unquoted, or empty values. Quoted values pass through [decode_escapes](src/dotenv/parser.py){show=symbol symbol=decode_escapes kind=function}. A failed read enters recovery, consumes the rest of the line, and returns error=True."
