	description=The reader now holds the complete input, including an empty string when the stream is empty.
	code=[initialize reader](src/dotenv/parser.py){show=symbol symbol=Reader.__init__ kind=Method focus="match[self.string = stream.read()]" context=3}
ps3: stream-parser -> stream-reader checks pair=ps-check role=call message=sync fragment="loop:each advance" operand="[consumer advances the generator]" note="→ reader.has_next()"
	description=Check before each binding. A false result ends the generator without another yield.
