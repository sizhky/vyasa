ps4: stream-reader -> stream-parser returns pair=ps-check role=reply fragment="loop:each advance" operand="[consumer advances the generator]" note="← True or False"
	description=Compare the current character position with the input length.
	code=[check position](src/dotenv/parser.py){show=symbol symbol=Reader.has_next kind=Method focus="match[return self.position.chars < len(self.string)]" context=1}
