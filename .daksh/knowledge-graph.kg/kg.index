e=ctx001 a=seq v=1 c=ctx001
e=ctx001 a=label v="Git refs — first-class production content" c=ctx001
e=ctx001 a=kind v=context c=ctx001
e=ctx001 a=caption v="Git refs become first-class Vyasa content: discoverable, browsable, refreshable, and explicit about every outcome.\nStage 40c is silent because existing controls need state behavior, not new screens or prototypes.\nStage 80 stays in git; stage 90 waits until implementation is accepted." c=ctx001
e=ctx001:vision a=kind v=slide c=ctx001
e=ctx001:vision a=slide_of v=@ctx001 c=ctx001
e=ctx001:vision a=title v="Why Git refs exist" c=ctx001
e=ctx001:vision a=shows v=@ask-1 c=ctx001
e=ctx001:vision a=shows v=@gap-1 c=ctx001
e=ctx001:vision a=shows v=@br-1 c=ctx001
e=ctx001:vision a=desc v="Repository history should read like live documentation, without changing a working tree." c=ctx001
e=ctx001:failure a=kind v=slide c=ctx001
e=ctx001:failure a=slide_of v=@ctx001 c=ctx001
e=ctx001:failure a=title v="What breaks trust today" c=ctx001
e=ctx001:failure a=shows v=@fact-1 c=ctx001
e=ctx001:failure a=shows v=@fact-2 c=ctx001
e=ctx001:failure a=shows v=@fact-3 c=ctx001
e=ctx001:failure a=shows v=@fact-4 c=ctx001
e=ctx001:failure a=shows v=@fact-5 c=ctx001
e=ctx001:failure a=shows v=@fact-6 c=ctx001
e=ctx001:failure a=desc v="The scoped mirror path is inert, failures collapse into 204, browser chains trust every response, and tests lock wiring rather than behavior." c=ctx001
e=ctx001:contract a=kind v=slide c=ctx001
e=ctx001:contract a=slide_of v=@ctx001 c=ctx001
e=ctx001:contract a=title v="One truthful action contract" c=ctx001
e=ctx001:contract a=shows v=@fr-2 c=ctx001
e=ctx001:contract a=shows v=@fr-3 c=ctx001
e=ctx001:contract a=shows v=@fr-4 c=ctx001
