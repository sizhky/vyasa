e=ctx001:contract a=shows v=@if-1 c=ctx001
e=ctx001:contract a=shows v=@state-1 c=ctx001
e=ctx001:contract a=desc v="Every action has one result shape and five visible states: loading, updated, unchanged, viewing, or failed." c=ctx001
e=ctx001:architecture a=kind v=slide c=ctx001
e=ctx001:architecture a=slide_of v=@ctx001 c=ctx001
e=ctx001:architecture a=title v="Put behavior where it belongs" c=ctx001
e=ctx001:architecture a=shows v=@el-1 c=ctx001
